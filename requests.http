@baseUrl = http://localhost:3000/v1
@gameId = replace-with-game-id
@gameSlug = minecraft
@categoryId = replace-with-category-id

### ===== Games (public) =====

### Get all games
GET {{baseUrl}}/games

### Get game by slug
GET {{baseUrl}}/games/{{gameSlug}}


### ===== Admin: games =====

### Create game
POST {{baseUrl}}/admin/games
Content-Type: application/json

{
  "title": "Minecraft",
  "slug": "minecraft",
  "coverUrl": "https://example.com/minecraft.png"
}

### Create game without cover
POST {{baseUrl}}/admin/games
Content-Type: application/json

{
  "title": "Dota 2",
  "slug": "dota-2",
  "coverUrl": null
}

### Update game
PATCH {{baseUrl}}/admin/games/{{gameId}}
Content-Type: application/json

{
  "title": "Minecraft Java Edition"
}

### Delete game
DELETE {{baseUrl}}/admin/games/{{gameId}}


### ===== Admin: categories =====

### Create category for game
POST {{baseUrl}}/admin/games/{{gameId}}/categories
Content-Type: application/json

{
  "title": "Accounts",
  "slug": "accounts"
}

### Update category
PATCH {{baseUrl}}/admin/categories/{{categoryId}}
Content-Type: application/json

{
  "title": "Game accounts"
}

### Delete category
DELETE {{baseUrl}}/admin/categories/{{categoryId}}
